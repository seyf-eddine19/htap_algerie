msgstr "ضيق التنفس عند الجهد"

#: .\templates\core\htap.html:96
msgid ""
"Unusual shortness of breath during light physical activity or daily tasks."
msgstr "ضيق تنفس غير معتاد أثناء النشاط البدني الخفيف أو المهام اليومية."

#: .\templates\core\htap.html:99
msgid "Chronic Fatigue"
msgstr "التعب المزمن"

#: .\templates\core\htap.html:100
msgid "Persistent feeling of exhaustion that is not relieved by rest."
msgstr "إحساس مستمر بالإرهاق لا يخف بالراحة."

#: .\templates\core\htap.html:103
